generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Which sizing scale a size label belongs to.
// ALPHA = letter sizes (XS-XL) used by shirts, jackets and dresses.
// WAIST = waist measurements in inches used by trousers.
enum SizeSystem {
  ALPHA
  WAIST
}

model Category {
  id       String    @id
  name     String    @unique
  products Product[]
}

model Product {
  id             String                 @id
  name           String
  description    String
  imagePath      String?
  categoryId     String
  category       Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  specifications ProductSpecifications?
  sizes          ProductSize[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([categoryId])
  @@index([name])
}

// One-to-one with Product. Sizes were moved out of this table into
// ProductSize so that each column holds a single atomic value (1NF).
model ProductSpecifications {
  productId String  @id
  material  String?
  fit       String?
  care      String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Lookup table: each size label is stored once.
model Size {
  id         Int           @id @default(autoincrement())
  label      String        @unique
  sizeSystem SizeSystem
  sortOrder  Int
  products   ProductSize[]
}

// Junction table for the many-to-many relationship Product <-> Size.
// stockQuantity depends on the whole key (productId, sizeId).
model ProductSize {
  productId     String
  sizeId        Int
  stockQuantity Int     @default(0)
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size          Size    @relation(fields: [sizeId], references: [id], onDelete: Restrict)

  @@id([productId, sizeId])
  @@index([sizeId])
}
